# Режим работы: development, test или production.
NODE_ENV="development"
PORT="3001"

# PostgreSQL обязателен, кроме явного локального demo-режима USE_MOCK=true.
DATABASE_URL="postgresql://app:replace-with-password@localhost:5432/3avhoz?schema=public"
USE_MOCK="false"

# Замените на уникальный секрет длиной не менее 32 символов.
JWT_SECRET="replace-with-a-unique-secret-at-least-32-characters-long"

# Через запятую. В production перечислите только реальные HTTPS origins, без '*'.
CORS_ORIGINS="http://localhost:5173"

# Datanewton: ключ хранится только на сервере и не передаётся в браузер.
DATANEWTON_API_KEY="replace-with-datanewton-api-key"
DATANEWTON_API_URL="http://10.0.61.230"
